---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import { topics, topicsIndex } from '../content/topics';

const tr = t('fa');
const en = t('en');
const links = (lang: 'fa' | 'en', label: (k: string) => string) => [
  [`/${lang}/`, label('nav.home')],
  [`/${lang}/blog/`, label('nav.blog')],
  [`/${lang}/projects/`, label('nav.projects')],
  [`/${lang}/services/`, label('nav.services')],
  [`/${lang}/about/`, label('nav.about')],
  [`/${lang}/map/`, label('nav.map')],
  [`/${lang}/topics/`, topicsIndex.title[lang]],
  ...topics.map((topic) => [`/${lang}/topics/${topic.id}/`, topic.title[lang]]),
];
---

<Base lang="fa" title={tr('notfound.title')} description={tr('notfound.body')} noindex alternate={false} motion={false}>
  <section class="section container miss">
    <h1 class="section-title">{tr('notfound.title')}</h1>
    <p class="section-lede">{tr('notfound.body')}</p>
    <div class="cols">
      <div lang="fa" dir="rtl">
        <h2>فارسی</h2>
        <ul>
          {links('fa', tr).map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div lang="en" dir="ltr">
        <h2>English</h2>
        <p class="section-lede">{en('notfound.body')}</p>
        <ul>
          {links('en', en).map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .miss {
    max-width: 46rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  h2 {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }
  .cols .section-lede {
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  a {
    color: var(--muted);
    text-decoration: none;
    border-radius: 999px;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
