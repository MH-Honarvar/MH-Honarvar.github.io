---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Scene3D from '../../components/Scene3D.astro';
import { studyFor } from '../../content/studies';
import { languages, t, type Lang } from '../../i18n/ui';
import { getPosts } from '../../lib/blog';
import { getRepos, getContributions, languageStats, langColor } from '../../lib/github';
import { SITE } from '../../config';
import RepoIcon from '../../components/RepoIcon.astro';
import { story } from '../../content/about';
import { publicCases } from '../../content/cases';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const allPosts = await getPosts(lang);
const posts = allPosts.slice(0, 4);
const repos = await getRepos();
const { total, days, privateTotal } = await getContributions();
const featured = repos.filter((r) => !r.private).slice(0, 3);
const strip = days.slice(-7 * 26);
const langCount = languageStats(repos).length;
const num = (n: number) => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const stats = [
  [repos.length, tr('projects.repos')],
  [allPosts.length, tr('hero.posts')],
  [langCount, tr('hero.langs')],
  [total, tr('projects.contribs')],
].filter(([n]) => n > 0) as [number, string][];
const sn = (i: number) => num(i).padStart(2, lang === 'fa' ? '۰' : '0');
const monthFmt = new Intl.DateTimeFormat(lang === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { month: 'short' });
const dayFmt = new Intl.DateTimeFormat(lang === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { day: 'numeric', month: 'long' });
const stripMonths: { col: number; label: string }[] = [];
for (let w = 0; w * 7 < strip.length; w++) {
  const label = monthFmt.format(new Date(strip[w * 7].date));
  if (stripMonths.at(-1)?.label !== label) stripMonths.push({ col: w + 1, label });
}
if (stripMonths.length > 1 && stripMonths[1].col - stripMonths[0].col < 3) stripMonths.shift();
const teaser = story[lang].split(/(?<=[.!?؟])\s/).slice(0, 2).join(' ');
const skills = ['TypeScript', 'Astro', 'Three.js', 'WebGL', 'GLSL', 'GSAP', 'CSS', 'Node.js', 'Git', 'UI Design', 'Typography', 'Motion'];
---

<Base lang={lang} title={tr('meta.homeTitle')} description={tr('meta.homeDesc')} image={`/og/${lang}/home.png`} intro motion>
  <Scene3D mode="hero" />
  <div id="home-progress" aria-hidden="true"></div>
  <nav class="rail" aria-label={tr('rail.label')}>
    <a href="#latest"><span>{sn(1)}</span><em>{tr('home.latest')}</em></a>
    <a href="#about"><span>{sn(2)}</span><em>{tr('home.aboutTitle')}</em></a>
    {(featured.length > 0 || publicCases.length > 0) && <a href="#projects"><span>{sn(3)}</span><em>{tr('home.projects')}</em></a>}
    {strip.length > 0 && <a href="#activity"><span>{sn(4)}</span><em>{tr('home.activity')}</em></a>}
    <a href="#contact"><span>·</span><em>{tr('home.contactTitle')}</em></a>
  </nav>
  <section class="hero container">
    <div class="copy" data-depth>
      <p class="status"><span class="dot"></span><span class="live">{tr('hero.status')}</span></p>
      <p class="eyebrow">{tr('hero.eyebrow')}</p>
      <h1 data-split data-highlight={tr('hero.word')}>{tr('hero.title')}</h1>
      <p class="promise">{tr('hero.promise')}</p>
      <p class="lede reveal">{tr('hero.lede')}</p>
      <p class="paths">
        <a href={`/${lang}/services/`}>{tr('home.toServices')}</a>
        <a href={`/${lang}/blog/persian-rtl-interface/`}>{tr('home.toRtl')}</a>
        <a href={`/${lang}/blog/type-and-space/`}>{tr('home.toType')}</a>
        <a href={`/${lang}/blog/static-pages-and-webgl/`}>{tr('home.toGl')}</a>
      </p>
      <div class="actions reveal">
        <a class="btn primary" href={`/${lang}/blog/`}>{tr('hero.cta')}</a>
        <a class="btn" href={`/${lang}/projects/`}>{tr('hero.cta2')}</a>
      </div>
      <ul class="points reveal">
        <li>{tr('hero.bilingual')}</li>
        <li>{tr('hero.fast')}</li>
        <li>{tr('hero.private')}</li>
      </ul>
      <dl class="stats glass reveal">
        {stats.map(([n, label]) => <div><dt data-count={n}>{num(n)}</dt><dd>{label}</dd></div>)}
      </dl>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[...skills, ...skills].map((s) => <span>{s}</span>)}
      </div>
    </div>
    <button class="sound glass" data-sound data-on={tr('sound.on')} data-off={tr('sound.off')} aria-pressed="false" title={tr('sound.off')} aria-label={tr('sound.off')}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
        <path class="waves" d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path class="mute" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <div class="scroll-hint" aria-hidden="true"><span class="line"></span>{tr('hero.scroll')}</div>
  </section>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('[data-sound]');
    if (btn) {
      const sync = () => {
        const on = localStorage.getItem('sound') === 'on';
        btn.setAttribute('aria-pressed', String(on));
        btn.title = btn.ariaLabel = on ? btn.dataset.on! : btn.dataset.off!;
      };
      btn.addEventListener('click', () => {
        localStorage.setItem('sound', localStorage.getItem('sound') === 'on' ? 'off' : 'on');
        sync();
      });
      sync();
    }

    const cells = document.querySelector<HTMLElement>('[data-cells]');
    const htip = document.querySelector<HTMLElement>('[data-htip]');
    if (cells && htip) {
      cells.addEventListener('pointerover', (e) => {
        const el = e.target as HTMLElement;
        if (!el.dataset.tip) return;
        htip.textContent = el.dataset.tip;
        htip.hidden = false;
        const p = htip.parentElement!.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        htip.style.left = `${r.left - p.left + r.width / 2}px`;
        htip.style.top = `${r.top - p.top}px`;
      });
      cells.addEventListener('pointerleave', () => (htip.hidden = true));
    }
  </script>

  <section class="section container" id="latest">
    <div class="head">
      <h2 class="section-title reveal"><span class="snum">{sn(1)}</span>{tr('home.latest')}</h2>
      <a href={`/${lang}/blog/`} class="all">{tr('home.all')}</a>
    </div>
    <div class="grid">
      {posts.map((post, i) => <PostCard post={post} lang={lang} index={i} />)}
    </div>
  </section>

  <section class="section container" id="about">
    <div class="head">
      <h2 class="section-title reveal"><span class="snum">{sn(2)}</span>{tr('home.aboutTitle')}</h2>
    </div>
    <a href={`/${lang}/about/`} class="mini glass reveal">
      <span class="mini-face" data-tilt>
        <img src={`https://github.com/${SITE.githubUser}.png?size=200`} alt={SITE.name[lang]} width="96" height="96" loading="lazy" onerror="this.style.visibility='hidden'" />
        <div>
          <b>{SITE.name[lang]}</b>
          <p>{teaser}</p>
          <span class="all">{tr('home.aboutMore')}</span>
        </div>
      </span>
    </a>
  </section>

  {
    (featured.length > 0 || publicCases.length > 0) && (
      <section class="section container" id="projects">
        <div class="head">
          <h2 class="section-title reveal"><span class="snum">{sn(3)}</span>{tr('home.projects')}</h2>
          <a href={`/${lang}/projects/`} class="all">{tr('home.allProjects')}</a>
        </div>
        <div class="projects">
          {publicCases.map((c) => (
            <a href={`/${lang}/projects/${c.slug}/`} class="proj glass reveal big" data-tilt>
              <h3>{c.title[lang]}</h3>
              <p>{c.summary[lang]}</p>
            </a>
          ))}
          {featured.map((r, i) => (
            <a href={studyFor(r.name) ? `/${lang}/projects/${r.name}/` : r.html_url} class:list={['proj glass reveal', { big: i === 0 && publicCases.length === 0 }]} data-tilt style={`--c:${langColor(r.language)}`}>
              <RepoIcon name={r.name} language={r.language} private={false} />
              <h3 dir="ltr">{r.name}</h3>
              <p>{r.description ?? '—'}</p>
              {r.language && <span class="lang" dir="ltr"><i />{r.language}</span>}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    strip.length > 0 && (
      <section class="section container activity" id="activity">
        <a href={`/${lang}/projects/`} class="heat glass reveal">
          <div class="heat-head">
            <span><span class="snum">{sn(4)}</span>{tr('home.activity')}</span>
            <b class="gradient-text">
              {num(total)} {tr('projects.commits')}
              {privateTotal > 0 && <small> · {num(privateTotal)} {tr('projects.inPrivate')}</small>}
            </b>
          </div>
          <div class="months" dir="ltr" style={`--weeks:${Math.ceil(strip.length / 7)}`}>
            {stripMonths.map((m) => <span style={`grid-column:${m.col}`}>{m.label}</span>)}
          </div>
          <div class="cells" dir="ltr" data-cells>
            {strip.map((d) => <span style={`--l:${d.level}`} data-tip={`${num(d.count)} ${tr('projects.commits')} · ${dayFmt.format(new Date(d.date))}`} />)}
          </div>
          <div class="htip glass" data-htip hidden></div>
        </a>
      </section>
    )
  }

  <section class="section container" id="contact">
    <div class="contact glass reveal">
      <div>
        <h2 class="gradient-text">{tr('home.contactTitle')}</h2>
        <p>{tr('home.contactBody')}</p>
      </div>
      <div class="contact-actions">
        <a class="btn primary" href={`https://t.me/${SITE.telegram}`}>Telegram @{SITE.telegram}</a>
        {SITE.email && <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        <a class="btn" href={`/${lang}/about/`}>{tr('nav.about')}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const bar = document.getElementById('home-progress');
  const rail = document.querySelector<HTMLElement>('.rail');
  const links = [...(rail?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  const reduce = document.documentElement.classList.contains('no-motion') || matchMedia('(prefers-reduced-motion: reduce)').matches;
  const paint = () => {
    if (!bar) return;
    const h = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
  };
  addEventListener('scroll', paint, { passive: true });
  paint();
  links.forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      e.preventDefault();
      if (reduce) document.getElementById(id)?.scrollIntoView({ block: 'start' });
      else document.dispatchEvent(new CustomEvent('site-scroll', { detail: id }));
    });
  });
  const targets = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(1))).filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const seen = new Map<string, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) seen.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        const current = [...seen.entries()].sort((a, b) => b[1] - a[1])[0];
        links.forEach((a) => a.classList.toggle('on', !!current && current[1] > 0 && a.getAttribute('href') === `#${current[0]}`));
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  #home-progress {
    position: fixed;
    top: 0;
    inset-inline: 0;
    height: 2px;
    z-index: 80;
    pointer-events: none;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) #home-progress {
    transform-origin: right;
  }
  .rail {
    position: fixed;
    z-index: 35;
    top: 50%;
    inset-inline-end: max(1rem, calc((100vw - 1100px) / 2 - 3rem));
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }
  .rail a {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.7rem;
    padding: 0.15rem 0.35rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .rail a span {
    width: 1.4rem;
    text-align: center;
    opacity: 0.7;
  }
  .rail em {
    font-style: normal;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.35s ease, opacity 0.35s ease;
  }
  .rail a.on,
  .rail a:hover {
    color: var(--fg);
  }
  .rail a.on span {
    color: var(--accent2);
    opacity: 1;
  }
  .rail a.on em,
  .rail a:hover em,
  .rail a:focus-visible em {
    max-width: 14rem;
    opacity: 1;
  }
  @media (max-width: 720px) {
    .rail {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail em {
      transition: none;
    }
  }
  :global(html.no-motion) .rail em {
    transition: none;
  }
  .section {
    scroll-margin-top: 5.5rem;
  }
  .hero {
    min-height: calc(100vh - 6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-bottom: 7.5rem;
    overflow-x: clip;
  }
  .eyebrow {
    color: var(--accent2);
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    line-height: 1.1;
    margin: 0.6rem 0 1.4rem;
    max-width: 14ch;
    font-weight: 800;
  }
  :global(.split-word) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
  }
  :global(.split-word > span) {
    display: inline-block;
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 50ch;
    margin: 0 0 2rem;
  }
  .paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.05rem;
    margin: -1.15rem 0 1.7rem;
    max-width: 42rem;
    font-size: 0.92rem;
  }
  .paths a {
    color: var(--muted);
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--accent2) 55%, transparent);
  }
  .paths a:hover {
    color: var(--accent2);
  }
  .actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .points li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .points li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent2);
  }
  .copy {
    position: relative;
    isolation: isolate;
    max-width: min(100%, 52%);
  }
  .copy::after {
    content: '';
    position: absolute;
    left: var(--hx, -999px);
    top: var(--hy, -999px);
    width: 240px;
    height: 240px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent2) 24%, transparent), transparent 68%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }
  .copy.lit::after {
    opacity: 1;
  }
  .copy > * {
    position: relative;
    z-index: 1;
  }
  :global(html.hero-stacked) .hero {
    justify-content: flex-end;
    padding-top: 36vh;
  }
  :global(html.hero-stacked) .copy {
    max-width: 100%;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.1rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    animation: ping 1.8s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 8px rgb(34 197 94 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(34 197 94 / 0);
    }
  }
  .live {
    animation: status-pulse 3.2s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.62;
    }
    50% {
      opacity: 1;
    }
  }
  :global(.hl) {
    background: linear-gradient(100deg, var(--accent), var(--accent2), var(--accent));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 5s linear infinite;
  }
  @keyframes sheen {
    to {
      background-position: -200% 0;
    }
  }
  .stats {
    display: grid;
    grid-auto-flow: column;
    gap: 0 2rem;
    width: fit-content;
    max-width: 100%;
    margin: 2.6rem 0 0;
    padding: 1rem 1.5rem;
    border-radius: 18px;
  }
  .stats div + div {
    border-inline-start: 1px solid var(--border);
    padding-inline-start: 2rem;
  }
  .stats dt {
    font-size: 1.9rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(100deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  @media (max-width: 640px) {
    .stats {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, auto);
      gap: 0.9rem 1.5rem;
    }
    .stats div + div {
      border: 0;
      padding: 0;
    }
  }
  .marquee {
    position: absolute;
    inset-inline: 0;
    bottom: 4.6rem;
    overflow: hidden;
    direction: ltr;
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    opacity: 0.6;
  }
  .track {
    display: flex;
    gap: 2.4rem;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .track span {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .track span::before {
    content: '◆';
    margin-inline-end: 2.4rem;
    color: var(--accent);
    font-size: 0.6em;
    vertical-align: middle;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
  .scroll-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .line {
    position: relative;
    width: 1px;
    height: 36px;
    background: var(--border);
    overflow: hidden;
  }
  .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--accent));
    animation: fall 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes fall {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track,
    .line::after,
    .dot,
    .live,
    :global(.hl) {
      animation: none;
    }
    .copy::after {
      display: none;
    }
    .live {
      opacity: 1;
    }
  }
  :global(html.no-motion) .track,
  :global(html.no-motion) .line::after,
  :global(html.no-motion) .dot,
  :global(html.no-motion) .live,
  :global(html.no-motion) :global(.hl) {
    animation: none;
  }
  :global(html.no-motion) .copy::after {
    display: none;
  }
  :global(html.no-motion) .live {
    opacity: 1;
  }
  .sound {
    position: absolute;
    bottom: 1.2rem;
    inset-inline-end: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    cursor: pointer;
  }
  .sound .waves,
  .sound[aria-pressed='false'] .waves {
    display: none;
  }
  .sound[aria-pressed='true'] .waves {
    display: inline;
  }
  .sound[aria-pressed='true'] .mute {
    display: none;
  }
  .sound[aria-pressed='true'] {
    color: var(--accent);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }
  .all {
    color: var(--accent);
    text-decoration: none;
  }
  .grid {
