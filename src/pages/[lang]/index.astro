---
import Base from '../../layouts/Base.astro';
import Scene3D from '../../components/Scene3D.astro';
import { languages, t, type Lang } from '../../i18n/ui';
import { SITE } from '../../config';
import { publicCases } from '../../content/cases';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const num = (n: number) => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const sn = (i: number) => num(i).padStart(2, lang === 'fa' ? '۰' : '0');
const work = publicCases[0];
---

<Base lang={lang} title={tr('meta.homeTitle')} description={tr('meta.homeDesc')} image={`/og/${lang}/home.png`} intro motion>
  <Scene3D mode="hero" />
  <div id="home-progress" aria-hidden="true"></div>
  <nav class="rail" aria-label={tr('rail.label')}>
    {work && <a href="#work"><span>{sn(1)}</span><em>{tr('home.work')}</em></a>}
    <a href="#contact"><span>·</span><em>{tr('home.contactTitle')}</em></a>
  </nav>
  <section class="hero container">
    <div class="copy" data-depth>
      <p class="eyebrow">{tr('hero.eyebrow')}</p>
      <h1 data-split data-highlight={tr('hero.word')}>{tr('hero.title')}</h1>
      <p class="lede reveal">{tr('hero.lede')}</p>
      {
        work && (
          <div class="actions reveal">
            <a class="btn primary" href={`/${lang}/projects/${work.slug}/`}>{tr('hero.cta')}</a>
          </div>
        )
      }
    </div>
    <button class="sound glass" data-sound data-on={tr('sound.on')} data-off={tr('sound.off')} aria-pressed="false" title={tr('sound.off')} aria-label={tr('sound.off')}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
        <path class="waves" d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path class="mute" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <div class="scroll-hint" aria-hidden="true"><span class="line"></span>{tr('hero.scroll')}</div>
  </section>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('[data-sound]');
    if (btn) {
      const sync = () => {
        const on = localStorage.getItem('sound') === 'on';
        btn.setAttribute('aria-pressed', String(on));
        btn.title = btn.ariaLabel = on ? btn.dataset.on! : btn.dataset.off!;
      };
      btn.addEventListener('click', () => {
        localStorage.setItem('sound', localStorage.getItem('sound') === 'on' ? 'off' : 'on');
        sync();
      });
      sync();
    }
  </script>

  {
    work && (
      <section class="section container" id="work">
        <div class="head">
          <h2 class="section-title reveal"><span class="snum">{sn(1)}</span>{tr('home.work')}</h2>
          <a href={`/${lang}/projects/`} class="all">{tr('home.allProjects')}</a>
        </div>
        <a href={`/${lang}/projects/${work.slug}/`} class="proj glass reveal" data-tilt>
          <h3>{work.title[lang]}</h3>
          <p>{work.summary[lang]}</p>
          <span class="all">{tr('hero.cta')}</span>
        </a>
      </section>
    )
  }

  <section class="section container" id="contact">
    <div class="contact glass reveal">
      <div>
        <h2 class="gradient-text">{tr('home.contactTitle')}</h2>
        <p>{tr('home.contactBody')}</p>
      </div>
      <div class="contact-actions">
        <a class="btn primary" href={`https://t.me/${SITE.telegram}`}>Telegram @{SITE.telegram}</a>
        {SITE.email && <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        <a class="btn" href={`/${lang}/about/`}>{tr('nav.about')}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const bar = document.getElementById('home-progress');
  const rail = document.querySelector<HTMLElement>('.rail');
  const links = [...(rail?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  const reduce = document.documentElement.classList.contains('no-motion') || matchMedia('(prefers-reduced-motion: reduce)').matches;
  const paint = () => {
    if (!bar) return;
    const h = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
  };
  addEventListener('scroll', paint, { passive: true });
  paint();
  links.forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      e.preventDefault();
      if (reduce) document.getElementById(id)?.scrollIntoView({ block: 'start' });
      else document.dispatchEvent(new CustomEvent('site-scroll', { detail: id }));
    });
  });
  const targets = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(1))).filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const seen = new Map<string, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) seen.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        const current = [...seen.entries()].sort((a, b) => b[1] - a[1])[0];
        links.forEach((a) => a.classList.toggle('on', !!current && current[1] > 0 && a.getAttribute('href') === `#${current[0]}`));
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  #home-progress {
    position: fixed;
    top: 0;
    inset-inline: 0;
    height: 2px;
    z-index: 80;
    pointer-events: none;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) #home-progress {
    transform-origin: right;
  }
  .rail {
    position: fixed;
    z-index: 35;
    top: 50%;
    inset-inline-end: max(1rem, calc((100vw - 1100px) / 2 - 3rem));
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }
  .rail a {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.7rem;
    padding: 0.15rem 0.35rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .rail a span {
    width: 1.4rem;
    text-align: center;
    opacity: 0.7;
  }
  .rail em {
    font-style: normal;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.35s ease, opacity 0.35s ease;
  }
  .rail a.on,
  .rail a:hover {
    color: var(--fg);
  }
  .rail a.on span {
    color: var(--accent2);
    opacity: 1;
  }
  .rail a.on em,
  .rail a:hover em,
  .rail a:focus-visible em {
    max-width: 14rem;
    opacity: 1;
  }
  /* The rail only fits in the gutter beside the 1100px column.
     Below that, max(1rem, …) pulls it onto the contact card and the hero. */
  @media (max-width: 1240px) {
    .rail {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail em {
      transition: none;
    }
  }
  :global(html.no-motion) .rail em {
    transition: none;
  }
  .section {
    scroll-margin-top: 5.5rem;
  }
  .hero {
    min-height: calc(100vh - 6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-bottom: 4.5rem;
    overflow-x: clip;
  }
  .eyebrow {
    color: var(--accent2);
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0;
  }
  h1 {
    font-size: clamp(2.15rem, 5.4vw, 4.35rem);
    line-height: 1.08;
    margin: 0.55rem 0 1rem;
    max-width: 16ch;
    font-weight: 800;
  }
  :global(.split-word) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
  }
  :global(.split-word > span) {
    display: inline-block;
  }
  .lede {
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 38ch;
    margin: 0 0 1.6rem;
  }
  .actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .copy {
    position: relative;
    isolation: isolate;
    max-width: min(100%, 34rem);
  }
  .copy::after {
    content: '';
    position: absolute;
    left: var(--hx, -999px);
    top: var(--hy, -999px);
    width: 240px;
    height: 240px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent2) 24%, transparent), transparent 68%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }
  .copy.lit::after {
    opacity: 1;
  }
  .copy > * {
    position: relative;
    z-index: 1;
  }
  :global(html.hero-stacked) .hero {
    justify-content: flex-end;
    padding-top: 32vh;
    padding-bottom: 5.75rem;
  }
  :global(html.hero-stacked) .copy {
    max-width: 100%;
  }
  :global(.hl) {
    background: linear-gradient(100deg, var(--accent), var(--accent2), var(--accent));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 5s linear infinite;
  }
  @keyframes sheen {
    to {
      background-position: -200% 0;
    }
  }
  .scroll-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    white-space: nowrap;
  }
  :global([dir='rtl']) .scroll-hint {
    letter-spacing: 0;
  }
  .line {
    position: relative;
    width: 1px;
    height: 36px;
    background: var(--border);
    overflow: hidden;
  }
  .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--accent));
    animation: fall 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes fall {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line::after,
    :global(.hl) {
      animation: none;
    }
    .copy::after {
      display: none;
    }
  }
  :global(html.no-motion) .line::after,
  :global(html.no-motion) :global(.hl) {
    animation: none;
  }
  :global(html.no-motion) .copy::after {
    display: none;
  }
  .sound {
    position: absolute;
    bottom: 1.2rem;
    inset-inline-end: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    cursor: pointer;
  }
  .sound .waves,
  .sound[aria-pressed='false'] .waves {
    display: none;
  }
  .sound[aria-pressed='true'] .waves {
    display: inline;
  }
  .sound[aria-pressed='true'] .mute {
    display: none;
  }
  .sound[aria-pressed='true'] {
    color: var(--accent);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
    gap: 0.35rem 1rem;
  }
  .all {
    color: var(--accent);
    text-decoration: none;
  }
  .proj {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 40rem;
    padding: 1.6rem 1.5rem 1.4rem;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease-out, border-color 0.3s;
    background-image: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent2) 22%, transparent), transparent 62%);
  }
  .proj::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent2) 18%, color-mix(in srgb, white 40%, var(--accent2)), var(--accent2) 82%, transparent);
  }
  .proj:hover {
    border-color: color-mix(in srgb, var(--accent2) 60%, transparent);
  }
  .proj h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    text-align: start;
  }
  .proj p {
    margin: 0 0 1rem;
    color: var(--muted);
    max-width: 48ch;
  }
  .snum {
    display: inline-block;
    margin-inline-end: 0.7rem;
    font-size: 0.5em;
    vertical-align: super;
    color: var(--accent2);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .contact {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    overflow: hidden;
  }
  .contact::before {
    content: '';
    position: absolute;
    inset-block-start: -40%;
    inset-inline-start: -10%;
    inset-inline-end: 30%;
    height: 180%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%);
    pointer-events: none;
  }
  .contact h2 {
    position: relative;
    margin: 0 0 0.3rem;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
  }
  .contact p {
    position: relative;
    margin: 0;
    color: var(--muted);
  }
  .contact-actions {
    position: relative;
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
</style>
