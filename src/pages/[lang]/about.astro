---
import Base from '../../layouts/Base.astro';
import { languages, t, formatMonth, type Lang } from '../../i18n/ui';
import { SITE } from '../../config';
import { getRepos, getContributions } from '../../lib/github';
import { getPosts, postUrl } from '../../lib/blog';
import { story, values, toolbox, faq } from '../../content/about';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const locale = lang === 'fa' ? 'fa-IR' : 'en-US';
const num = (n: number) => n.toLocaleString(locale);
const repos = await getRepos();
const { total, privateTotal } = await getContributions();
const posts = await getPosts(lang);

const yearFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', ...(lang === 'fa' ? { calendar: 'persian' } : {}) });
const pub = repos.filter((r) => !r.private && r.created_at).sort((a, b) => a.created_at.localeCompare(b.created_at));
const byYear = new Map<string, { sort: string; names: string[]; priv: number }>();
const bucket = (label: string, sort: string) => {
  const e = byYear.get(label) ?? { sort, names: [], priv: 0 };
  if (sort < e.sort) e.sort = sort;
  byYear.set(label, e);
  return e;
};
for (const r of pub) bucket(yearFmt.format(new Date(r.created_at)), r.created_at).names.push(r.name);
for (const r of repos) if (r.private && r.activity) bucket(yearFmt.format(new Date(`${r.activity.first}-15`)), `${r.activity.first}-15`).priv++;
const entries = [...byYear.entries()].sort((a, b) => a[1].sort.localeCompare(b[1].sort));
const nowLabel = yearFmt.format(new Date());
const timeline = entries.map(([when, e], i) => ({
  when,
  title: [
    e.names.length ? (i === 0 && pub.length ? tr('about.firstRepo') : `${num(e.names.length)} ${tr('about.reposIn')}`) : '',
    e.priv ? `${num(e.priv)} ${tr('about.privateIn')}` : '',
  ].filter(Boolean).join(' · '),
  body: e.names.join(' · '),
  now: when === nowLabel,
}));
if (!timeline.some((e) => e.now)) timeline.push({ when: nowLabel, title: tr('about.now'), body: '', now: true });
else timeline[timeline.length - 1].body = [timeline[timeline.length - 1].body, tr('about.now')].filter(Boolean).join(' · ');

const firstDate = [pub[0]?.created_at, ...repos.map((r) => r.activity?.first && `${r.activity.first}-01`)].filter(Boolean).sort()[0] as string | undefined;
const years = Math.max(1, new Date().getFullYear() - (firstDate ? new Date(firstDate).getFullYear() : new Date().getFullYear()) + 1);

const doing = [
  { key: 'design', icon: 'M4 20l4-1 11-11-3-3L5 16l-1 4zM14 6l3 3' },
  { key: 'code', icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16' },
  { key: 'write', icon: 'M5 4h10l4 4v12H5zM14 4v5h5M8 13h8M8 17h5' },
] as const;

const stats = [
  [years, tr('about.years')],
  [repos.length, tr('projects.repos')],
  [total, tr('projects.contribs')],
  [privateTotal, tr('projects.inPrivate')],
].filter(([n]) => (n as number) > 0) as [number, string][];

const latestRepo = repos.find((r) => !r.private);
const latestPost = posts[0];
const words = story[lang].split(' ');
---

<Base lang={lang} title={tr('about.title')} description={story[lang].split(/(?<=[.!?؟])\s/)[0]} image={`/og/${lang}/about.png`}>
  <section class="section container about" data-pagefind-body>
    <header class="intro">
      <div class="avatar" data-avatar>
        <span class="ring" aria-hidden="true"></span>
        {Array.from({ length: 6 }, (_, i) => <span class="orb" style={`--i:${i}`} aria-hidden="true" />)}
        <div class="blob">
          <img
            src={`https://github.com/${SITE.githubUser}.png?size=320`}
            alt={SITE.name[lang]}
            width="160"
            height="160"
            onerror="this.replaceWith(Object.assign(document.createElement('b'),{textContent:this.alt.trim()[0],className:'initial'}))"
          />
        </div>
      </div>
      <div>
        <p class="kicker">{tr('about.title')}</p>
        <h1 data-split>{SITE.name[lang]}</h1>
        <p class="typed" aria-label={tr('about.roles').replaceAll('|', '، ')}>
          <span data-roles={tr('about.roles')}>{tr('about.roles').split('|')[0]}</span><i aria-hidden="true"></i>
        </p>
        <p class="body reveal">{tr('about.body')}</p>
      </div>
    </header>

    {
      stats.length > 0 && (
        <dl class="stats glass reveal">
          {stats.map(([n, label]) => (
            <div>
              <dt data-count={n}>{num(n)}</dt>
              <dd>{label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <h2 class="sub reveal">{tr('about.story')}</h2>
    <p class="story" data-story>
      {words.map((w) => <span>{w} </span>)}
    </p>

    <div class="now glass reveal">
      <h2><i class="live" aria-hidden="true"></i>{tr('about.nowTitle')}</h2>
      <div class="now-grid">
        {
          latestRepo && (
            <a href={latestRepo.html_url}>
              <small>{tr('about.nowRepo')}</small>
              <b dir="ltr">{latestRepo.name}</b>
              {latestRepo.description && <span>{latestRepo.description}</span>}
            </a>
          )
        }
        {
          latestPost && (
            <a href={postUrl(latestPost)}>
              <small>{tr('about.nowPost')}</small>
              <b>{latestPost.data.title}</b>
              <span>{latestPost.data.description}</span>
            </a>
          )
        }
        <div>
          <small>{tr('projects.lastCommit')}</small>
          <b>{tr('about.now')}</b>
          {repos.some((r) => r.private && r.activity?.recent) && <span>{tr('projects.working')} · {tr('projects.private')}</span>}
        </div>
      </div>
    </div>

    <h2 class="sub reveal">{tr('about.doing')}</h2>
    <div class="doing">
      {
        doing.map((d) => (
          <article class="do glass reveal" data-tilt>
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
              <path d={d.icon} />
            </svg>
            <h3>{tr(`about.${d.key}`)}</h3>
            <p>{tr(`about.${d.key}Body`)}</p>
          </article>
        ))
      }
    </div>

    <h2 class="sub reveal">{tr('about.values')}</h2>
    <div class="values">
      {
        values.map((v, i) => (
          <article class="value glass reveal" style={`--d:${i * 80}ms`}>
            <span class="vnum">{num(i + 1).padStart(2, lang === 'fa' ? '۰' : '0')}</span>
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d={v.icon} /></svg>
            <h3>{v.title[lang]}</h3>
            <p>{v.body[lang]}</p>
          </article>
        ))
      }
    </div>

    <h2 class="sub reveal">{tr('about.skills')}</h2>
    <div class="toolbox">
      <div class="orbit" aria-hidden="true">
        <span class="core">{SITE.name[lang].trim()[0]}</span>
        {toolbox.map((tl, i) => (
          <span class="sat" style={`--a:${(360 / toolbox.length) * i}deg`}>
            <svg viewBox="0 0 24 24" width="22" height="22"><path d={tl.icon} /></svg>
          </span>
        ))}
      </div>
      <ul class="tools">
        {
          toolbox.map((tl) => (
            <li class="reveal">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={tl.icon} /></svg>
              <span dir="ltr">{tl.name}</span>
              <span class="lvl" style={`--l:${tl.level}%`} aria-hidden="true"><i /></span>
            </li>
          ))
        }
      </ul>
    </div>

    <h2 class="sub reveal">{tr('about.timeline')}</h2>
    <div class="htl-wrap" data-timeline>
      <ol class="htl">
        <span class="track" aria-hidden="true"><span class="fill"></span></span>
        {
          timeline.map((e) => (
            <li class:list={['reveal', { now: e.now }]}>
              <span class="dot" aria-hidden="true" />
              <time>{e.when}</time>
              <h3>{e.title}</h3>
              {e.body && <p>{e.body}</p>}
            </li>
          ))
        }
      </ol>
    </div>

    <h2 class="sub reveal">{tr('about.faq')}</h2>
    <div class="faq">
      {
        faq.map((f) => (
          <details class="glass reveal">
            <summary>{f.q[lang]}</summary>
            <p>{f.a[lang]}</p>
          </details>
        ))
      }
    </div>

    <div class="cta glass reveal">
      <span class="mesh" aria-hidden="true"></span>
      <h2 class="gradient-text">{tr('about.ctaTitle')}</h2>
      <p>{tr('about.ctaBody')}</p>
      <p class="clock">{tr('about.localTime')}: <b data-clock data-locale={locale}>--:--</b></p>
      <div class="contact">
        <a class="btn primary" href={`https://t.me/${SITE.telegram}`}>Telegram @{SITE.telegram}</a>
        {SITE.email && <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        <a class="btn" href={`https://github.com/${SITE.githubUser}`}>GitHub</a>
        <button class="btn copy" data-copy={`@${SITE.telegram}`} data-done={tr('about.copied')}>{tr('about.copy')}</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 3rem;
  }
  .avatar {
    position: relative;
    flex-shrink: 0;
    width: 168px;
    height: 168px;
    display: grid;
    place-items: center;
  }
  .avatar::before {
    content: '';
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 35%, transparent), transparent 65%);
    filter: blur(10px);
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), var(--accent2), transparent 60%, var(--accent));
    animation: spin 6s linear infinite;
    mask: radial-gradient(circle, transparent 77px, #000 78px);
    -webkit-mask: radial-gradient(circle, transparent 77px, #000 78px);
  }
  .avatar img {
    position: relative;
    display: block;
    width: 148px;
    height: 148px;
    object-fit: cover;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .kicker {
    margin: 0;
    color: var(--accent2);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.1;
    margin: 0.3rem 0 0.4rem;
  }
  .typed {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
    min-height: 1.7em;
  }
  .typed span {
    background: linear-gradient(100deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .typed i {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-inline-start: 3px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .body {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 60ch;
  }
  .stats {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    padding: 1.2rem 0;
  }
  .stats div {
    padding-inline: 1.5rem;
  }
  .stats div + div {
    border-inline-start: 1px solid var(--border);
  }
  .stats dt {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    background: linear-gradient(100deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .sub {
    font-size: 1.5rem;
    margin: 3.5rem 0 1.2rem;
  }
  .doing {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.2rem;
  }
  .do {
    position: relative;
    padding: 1.6rem;
    overflow: hidden;
    transition: transform 0.2s ease-out, border-color 0.3s;
    background-image: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%);
  }
  .do:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .do svg {
    fill: none;
    stroke: var(--accent2);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 80;
    stroke-dashoffset: 0;
  }
  .do:hover svg path {
    animation: draw 1.1s ease-out;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 80;
    }
  }
  .do h3 {
    margin: 0.8rem 0 0.3rem;
    font-size: 1.2rem;
  }
  .do p {
    margin: 0;
    color: var(--muted);
  }
  .story {
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.75;
    font-weight: 600;
    max-width: 38em;
    margin: 0;
  }
  .story span {
    opacity: var(--o, 0.18);
    transition: opacity 0.25s;
  }
  .now {
    margin-top: 3rem;
    padding: 1.5rem 1.6rem;
  }
  .now h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }
  .live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3fb950;
    box-shadow: 0 0 0 0 #3fb95088;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    to {
      box-shadow: 0 0 0 12px #3fb95000;
    }
  }
  .now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
  }
  .now-grid > * {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .now-grid a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .now-grid small {
    color: var(--accent2);
    font-size: 0.78rem;
  }
  .now-grid span {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 1.2rem;
  }
  .value {
    position: relative;
    padding: 1.5rem;
    overflow: hidden;
    transition-delay: var(--d);
  }
  .vnum {
    position: absolute;
    inset-inline-end: 1rem;
    top: 0.4rem;
    font-size: 3rem;
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .value svg,
  .tools svg,
  .sat svg {
    fill: none;
    stroke: var(--accent2);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .value h3 {
    margin: 0.7rem 0 0.3rem;
    font-size: 1.1rem;
  }
  .value p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
  }
  .toolbox {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .orbit {
    position: relative;
    width: 244px;
    margin: 24px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed var(--border);
    animation: spin 40s linear infinite;
  }
  .core {
    position: absolute;
    inset: 32%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 2.2rem;
    font-weight: 900;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    box-shadow: 0 0 50px color-mix(in srgb, var(--accent) 50%, transparent);
    animation: spin 40s linear infinite reverse;
  }
  .sat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46px;
    height: 46px;
    margin: -23px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--glass);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    transform: rotate(var(--a)) translate(122px) rotate(calc(-1 * var(--a)));
  }
  .sat svg {
    animation: spin 40s linear infinite reverse;
  }
  .tools {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .tools li {
    display: grid;
    grid-template-columns: 24px 9rem 1fr;
    align-items: center;
    gap: 0.8rem;
  }
  .lvl {
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .lvl i {
    display: block;
    height: 100%;
    width: var(--l);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transform-origin: left;
    animation: grow 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-timeline: view();
    animation-range: entry 0% cover 35%;
  }
  :global([dir='rtl']) .lvl i {
    transform-origin: right;
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  .htl-wrap {
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }
  .htl {
    position: relative;
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 2.2rem 0 0;
    min-width: max-content;
  }
  .track {
    position: absolute;
    top: 0.75rem;
    inset-inline: 0;
    height: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  :global([dir='rtl']) .fill {
    transform-origin: right;
  }
  .htl li {
    position: relative;
    width: 250px;
    padding: 1.1rem 1.2rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--glass);
  }
  .htl li.now {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .dot {
    position: absolute;
    top: -1.95rem;
    inset-inline-start: 1.2rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .now .dot {
    background: var(--accent2);
  }
  .htl time {
    color: var(--accent2);
    font-weight: 800;
    font-size: 1.3rem;
  }
  .htl h3 {
    margin: 0.2rem 0;
    font-size: 1rem;
  }
  .htl p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .faq {
    display: grid;
    gap: 0.8rem;
  }
  .faq details {
    padding: 0 1.3rem;
    border-radius: 1rem;
  }
  .faq summary {
    cursor: pointer;
    padding: 1.1rem 0;
    font-weight: 700;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq summary::after {
    content: '+';
    color: var(--accent);
    font-size: 1.3rem;
    line-height: 1;
    transition: transform 0.3s;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq p {
    margin: 0 0 1.1rem;
    color: var(--muted);
  }
  .blob {
    position: relative;
    width: 148px;
    height: 148px;
    overflow: hidden;
    border-radius: 50%;
    animation: morph 9s ease-in-out infinite;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: grid;
    place-items: center;
  }
  .blob :global(.initial) {
    font-size: 4rem;
    color: #fff;
  }
  @keyframes morph {
    0%, 100% { border-radius: 50% 50% 50% 50%; }
    33% { border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%; }
    66% { border-radius: 44% 56% 40% 60% / 58% 42% 58% 42%; }
  }
  .orb {
    position: absolute;
    inset: 0;
    animation: spin calc(5s + var(--i) * 1.3s) linear infinite;
  }
  .orb::before {
    content: '';
    position: absolute;
    top: calc(-6px - var(--i) * 3px);
    left: 50%;
    width: calc(4px + var(--i) % 3 * 2px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 10px var(--accent2);
  }
  .avatar {
    transition: transform 0.2s ease-out;
    transform: perspective(600px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
  }
  .mesh {
    position: absolute;
    inset: -40%;
    background:
      radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 40%),
      radial-gradient(circle at 80% 60%, color-mix(in srgb, var(--accent2) 26%, transparent), transparent 40%);
    animation: spin 24s linear infinite;
    pointer-events: none;
  }
  .clock {
    font-size: 0.9rem;
  }
  .clock b {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 820px) {
    .toolbox {
      grid-template-columns: 1fr;
    }
    .orbit {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit, .core, .sat svg, .orb, .blob, .mesh, .ring {
      animation: none;
    }
    .story span {
      opacity: 1;
    }
  }
  .cta {
    position: relative;
    margin-top: 3rem;
    padding: clamp(1.8rem, 5vw, 3.2rem);
    text-align: center;
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: auto -20% -60%;
    height: 120%;
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 60%);
    pointer-events: none;
  }
  .cta h2 {
    position: relative;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    margin: 0 0 0.6rem;
  }
  .cta p {
    position: relative;
    color: var(--muted);
    margin: 0 auto 1.6rem;
    max-width: 48ch;
  }
  .contact {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .copy {
    font: inherit;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .intro {
      flex-direction: column;
      text-align: center;
    }
    .stats {
      grid-auto-flow: row;
      gap: 1rem;
    }
    .stats div + div {
      border: 0;
    }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const el = document.querySelector<HTMLElement>('[data-roles]');
  if (el && !reduced) {
    const roles = el.dataset.roles!.split('|');
    let r = 0;
    let i = roles[0].length;
    let deleting = true;
    const tick = () => {
      const word = roles[r];
      i += deleting ? -1 : 1;
      el.textContent = word.slice(0, i);
      let wait = deleting ? 40 : 75;
      if (!deleting && i === word.length) {
        deleting = true;
        wait = 1800;
      } else if (deleting && i === 0) {
        deleting = false;
        r = (r + 1) % roles.length;
        wait = 300;
      }
      setTimeout(tick, wait);
    };
    setTimeout(tick, 2200);
  }

  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    const update = () => {
      const r = tl.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top) / r.height));
      tl.style.setProperty('--p', String(reduced ? 1 : p));
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }

  const storyEl = document.querySelector<HTMLElement>('[data-story]');
  if (storyEl && !reduced) {
    const spans = [...storyEl.children] as HTMLElement[];
    const scrub = () => {
      const r = storyEl.getBoundingClientRect();
      const p = (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35);
      const lit = Math.round(Math.min(1, Math.max(0, p)) * spans.length);
      spans.forEach((sp, i) => sp.style.setProperty('--o', i < lit ? '1' : '0.18'));
    };
    addEventListener('scroll', scrub, { passive: true });
    scrub();
  }

  const av = document.querySelector<HTMLElement>('[data-avatar]');
  if (av && !reduced && matchMedia('(pointer: fine)').matches) {
    addEventListener('pointermove', (e) => {
      const r = av.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
      const dy = (e.clientY - (r.top + r.height / 2)) / innerHeight;
      av.style.setProperty('--rx', `${dx * 24}deg`);
      av.style.setProperty('--ry', `${-dy * 24}deg`);
    });
  }

  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat(clock.dataset.locale, { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Tehran' });
    const tickClock = () => (clock.textContent = fmt.format(new Date()));
    tickClock();
    setInterval(tickClock, 1000);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy!);
      b.textContent = b.dataset.done!;
      setTimeout(() => (b.textContent = label), 1600);
    });
  });
</script>
