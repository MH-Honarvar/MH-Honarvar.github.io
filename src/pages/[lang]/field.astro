---
import Base from '../../layouts/Base.astro';
import { languages, t, type Lang } from '../../i18n/ui';
import { getPosts, postSlug, postUrl } from '../../lib/blog';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const num = (n: number) => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const order = [
  'bar-language-and-theme',
  'quote-is-a-request',
  'three-offices',
  'the-port-stays',
  'logistics-first-screen',
  'three-languages-one-page',
  'title-before-the-scene',
  'one-next-step',
];
const bySlug = new Map((await getPosts(lang)).map((post) => [postSlug(post), post]));
const posts = order.flatMap((slug) => {
  const post = bySlug.get(slug);
  return post ? [post] : [];
});
---

<Base lang={lang} title={tr('field.title')} description={tr('field.lede')} motion={false}>
  <section class="section container">
    <h1 class="section-title">{tr('field.title')}</h1>
    <p class="section-lede">{tr('field.lede')}</p>
    <ol class="notes">
      {
        posts.map((post, i) => (
          <li>
            <a href={postUrl(post)}>
              <b>{num(i + 1).padStart(2, lang === 'fa' ? '۰' : '0')}</b>
              <span>
                <strong>{post.data.title}</strong>
                {post.data.description}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .notes {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .notes a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.95rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .notes li:last-child a {
    border-bottom: 1px solid var(--border);
  }
  .notes b {
    color: var(--accent2);
    font-size: 0.8rem;
    font-weight: 700;
    padding-top: 0.25rem;
  }
  .notes strong {
    display: block;
    margin-bottom: 0.2rem;
  }
  .notes span {
    color: var(--muted);
  }
  .notes strong {
    color: var(--fg);
  }
</style>
