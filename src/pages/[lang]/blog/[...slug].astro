---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import { formatDate, languages, other, t, type Lang } from '../../../i18n/ui';
import { getPosts, minutes, postSlug } from '../../../lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    const posts = await getPosts(lang);
    const otherSlugs = new Set((await getPosts(other(lang))).map(postSlug));
    for (const post of posts) {
      const slug = postSlug(post);
      paths.push({ params: { lang, slug }, props: { post, hasTwin: otherSlugs.has(slug) } });
    }
  }
  return paths;
}

const { post, hasTwin } = Astro.props;
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const slug = postSlug(post);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
const vt = `post-${slug.replace(/[^a-z0-9-]/gi, '')}`;
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={`/og/${lang}/${slug}.png`}
  altPath={hasTwin ? `/${other(lang)}/blog/${slug}/` : `/${other(lang)}/blog/`}
>
  <div id="read-progress"></div>
  <article class="container post" data-pagefind-body>
    <header>
      <a href={`/${lang}/blog/`} class="back" data-pagefind-ignore>{tr('blog.back')}</a>
      <h1 style={`view-transition-name: ${vt}`}>{post.data.title}</h1>
      <p class="meta" data-pagefind-ignore>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        · {minutes(post).toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US')} {tr('blog.minutes')}
      </p>
      <div class="tags" data-pagefind-ignore>
        {post.data.tags.map((tg) => <a class="tag" href={`/${lang}/blog/tags/${tg}/`}>#{tg}</a>)}
      </div>
    </header>

    <div class="layout">
      {
        toc.length > 1 && (
          <aside class="toc glass" data-pagefind-ignore>
            <p>{tr('blog.toc')}</p>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>

    <div data-pagefind-ignore><Comments lang={lang} /></div>
  </article>
</Base>

<style>
  #read-progress {
    position: fixed;
    top: 0;
    inset-inline: 0;
    height: 3px;
    z-index: 100;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) #read-progress {
    transform-origin: right;
  }
  .post {
    padding-top: 4rem;
  }
  header {
    max-width: 760px;
    margin-bottom: 3rem;
  }
  .back {
    color: var(--accent);
    text-decoration: none;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.2;
    margin: 1rem 0;
  }
  .meta {
    color: var(--muted);
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 3rem;
    align-items: start;
  }
  .toc {
    order: 2;
    position: sticky;
    top: 6rem;
    padding: 1.2rem;
    font-size: 0.9rem;
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    padding: 0.2rem 0;
  }
  .toc .d3 {
    padding-inline-start: 1rem;
  }
  .toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover,
  .toc a.on {
    color: var(--accent);
  }
  .prose {
    max-width: 72ch;
    font-size: 1.08rem;
  }
  .prose :global(h2),
  .prose :global(h3) {
    line-height: 1.3;
    margin-top: 2.5rem;
    scroll-margin-top: 6rem;
  }
  .prose :global(a) {
    color: var(--accent2);
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 1.2rem;
    border-inline-start: 3px solid var(--accent);
    background: var(--glass);
    border-radius: 0.5rem;
  }
  .prose :global(pre) {
    position: relative;
    direction: ltr;
    text-align: left;
    padding: 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .prose :global(:not(pre) > code) {
    background: var(--glass);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 0.35rem;
    font-size: 0.9em;
  }
  .prose :global(.copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--fg);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .prose :global(pre:hover .copy-btn) {
    opacity: 1;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 1rem;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.hash === `#${e.target.id}`));
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((a) => {
      const h = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (h) obs.observe(h);
    });
  }
</script>
