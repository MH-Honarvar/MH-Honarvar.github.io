---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/blog';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const posts = await getPosts(lang);
const counts = new Map<string, number>();
for (const p of posts) for (const tg of p.data.tags) counts.set(tg, (counts.get(tg) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const num = (n: number) => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
---

<Base
  lang={lang}
  title={tr('blog.title')}
  description={tr('blog.lede')}
  crumbs={[
    { name: tr('nav.home'), url: `/${lang}/` },
    { name: tr('nav.blog'), url: `/${lang}/blog/` },
  ]}
>
  <section class="section container">
    <h1 class="section-title" data-split>{tr('blog.title')}</h1>
    <p class="section-lede">{tr('blog.lede')}</p>

    <div class="search-wrap">
      <div id="search" class="glass" data-lang={lang} data-placeholder={tr('blog.search')}></div>
      <span class="search-hint">{tr('blog.searchHint')}</span>
    </div>

    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map(([tg, n]) => (
            <a class="pill" href={`/${lang}/blog/tags/${tg}/`} data-tag={tg}>
              #{tg} <small>{num(n)}</small>
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length ? (
        <div class="grid">
          {posts.map((post, i) => (
            <PostCard post={post} lang={lang} index={i} featured={i === 0} heading="h2" />
          ))}
        </div>
      ) : (
        <div class="empty glass">
          <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true">
            <rect x="14" y="8" width="36" height="48" rx="5" />
            <path d="M22 22h20M22 30h20M22 38h12" />
            <circle cx="46" cy="46" r="9" />
            <path d="M52.5 52.5 58 58" />
          </svg>
          <h2>{tr('blog.empty')}</h2>
          <p>{tr('blog.emptyBody')}</p>
        </div>
      )
    }
  </section>
</Base>

<style>
  .search-wrap {
    position: relative;
    margin-bottom: 1.5rem;
  }
  #search {
    padding: 0.4rem;
  }
  .search-hint {
    position: absolute;
    top: 1.05rem;
    inset-inline-end: 1.1rem;
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--border);
    color: var(--muted);
    pointer-events: none;
  }
  .search-wrap:focus-within .search-hint {
    opacity: 0;
  }
  .pill.on {
    color: var(--fg);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.5rem 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--glass);
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  :global([dir='rtl']) .pill {
    padding: 0.3rem 0.85rem 0.3rem 0.5rem;
  }
  .pill small {
    min-width: 1.4rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.72rem;
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--fg);
  }
  .pill:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .empty {
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .empty svg {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .empty h2 {
    margin: 1rem 0 0.3rem;
  }
  .empty p {
    margin: 0;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  :global(#search .pagefind-ui) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--glass);
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-font: inherit;
  }
  :global(#search .pagefind-ui__search-input) {
    font-weight: 500;
    padding-left: 4.6rem;
  }
  :global(#search .pagefind-ui__search-input:focus) {
    outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: 0;
  }
  :global(#search .pagefind-ui__result) {
    border-color: var(--border);
  }
</style>

<script>
  const pills = [...document.querySelectorAll<HTMLAnchorElement>('[data-tag]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tags]')];
  const query = new URLSearchParams(location.search).get('q')?.trim().toLowerCase() ?? '';
  let activeTag = '';
  const apply = () => {
    cards.forEach((c) => {
      const tagOk = !activeTag || c.dataset.tags!.split(' ').includes(activeTag);
      const qOk = !query || (c.textContent ?? '').toLowerCase().includes(query);
      c.hidden = !(tagOk && qOk);
    });
  };
  apply();
  pills.forEach((p) =>
    p.addEventListener('click', (e) => {
      e.preventDefault();
      const on = !p.classList.contains('on');
      pills.forEach((x) => x.classList.toggle('on', on && x === p));
      activeTag = on ? p.dataset.tag! : '';
      if (document.startViewTransition) document.startViewTransition(apply);
      else apply();
    }),
  );

  const el = document.getElementById('search')!;
  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = '/pagefind/pagefind-ui.css';
  const js = document.createElement('script');
  js.src = '/pagefind/pagefind-ui.js';
  js.onload = () => {
    // @ts-expect-error injected by pagefind-ui.js
    new window.PagefindUI({ element: el, showSubResults: true, showImages: false, translations: { placeholder: el.dataset.placeholder } });
    if (!query) return;
    const input = el.querySelector('input');
    if (!input) return;
    input.value = query;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  };
  js.onerror = () => el.closest('.search-wrap')?.remove();
  document.head.append(css, js);
</script>
