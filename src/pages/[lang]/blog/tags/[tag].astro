---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PostCard from '../../../../components/PostCard.astro';
import { languages, other, pairedTag, t, type Lang } from '../../../../i18n/ui';
import { getPosts } from '../../../../lib/blog';
import { tagIndexable, tagIntro } from '../../../../lib/tags';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    const posts = await getPosts(lang);
    for (const tag of new Set(posts.flatMap((p) => p.data.tags))) {
      paths.push({ params: { lang, tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { tag } = Astro.params;
const { posts } = Astro.props;
const tr = t(lang);
const twin = pairedTag(lang, tag);
const indexable = !!twin && tagIndexable(lang, tag) && tagIndexable(other(lang), twin);
const intro = tagIntro[tag];
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: tr('nav.blog'), url: `/${lang}/blog/` },
  { name: `#${tag}`, url: `/${lang}/blog/tags/${tag}/` },
];
---

<Base
  lang={lang}
  title={`#${tag}`}
  description={indexable && intro ? intro : `${tr('blog.tagDesc')} #${tag}`}
  alternate={indexable}
  noindex={!indexable}
  motion={false}
  altPath={indexable && twin ? `/${other(lang)}/blog/tags/${encodeURIComponent(twin)}/` : undefined}
  crumbs={crumbs}
>
  <section class="section container">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <p class="kicker">{tr('blog.tag')}</p>
    <h1 class="section-title gradient-text">#{tag}</h1>
    {intro && indexable && <p class="intro">{intro}</p>}
    <a href={`/${lang}/blog/`} class="back">{tr('blog.back')}</a>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} lang={lang} heading="h2" />)}
    </div>
  </section>
</Base>

<style>
  .kicker {
    color: var(--muted);
    margin: 0;
  }
  .back {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    margin: 0.5rem 0 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
</style>
