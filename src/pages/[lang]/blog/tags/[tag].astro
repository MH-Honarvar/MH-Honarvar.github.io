---
import Base from '../../../../layouts/Base.astro';
import PostCard from '../../../../components/PostCard.astro';
import { languages, t, type Lang } from '../../../../i18n/ui';
import { getPosts } from '../../../../lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    const posts = await getPosts(lang);
    for (const tag of new Set(posts.flatMap((p) => p.data.tags))) {
      paths.push({ params: { lang, tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { tag } = Astro.params;
const { posts } = Astro.props;
const tr = t(lang);
---

<Base lang={lang} title={`#${tag}`} description={`${tr('blog.tagDesc')} #${tag}`} alternate={false}>
  <section class="section container">
    <p class="kicker">{tr('blog.tag')}</p>
    <h1 class="section-title gradient-text">#{tag}</h1>
    <a href={`/${lang}/blog/`} class="back">{tr('blog.back')}</a>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>
</Base>

<style>
  .kicker {
    color: var(--muted);
    margin: 0;
  }
  .back {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    margin: 0.5rem 0 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
</style>
