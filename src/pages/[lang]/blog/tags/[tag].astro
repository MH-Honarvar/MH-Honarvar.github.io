---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { formatDate, languages, other, t, type Lang } from '../../../../i18n/ui';
import { getPosts, minutes, postUrl } from '../../../../lib/blog';
import { pairedTag, tagIndexable, tagIntro } from '../../../../lib/tags';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    const posts = await getPosts(lang);
    for (const tag of new Set(posts.flatMap((p) => p.data.tags))) {
      paths.push({ params: { lang, tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { tag } = Astro.params;
const { posts } = Astro.props;
const tr = t(lang);
const twin = pairedTag(lang, tag);
const indexable = tagIndexable(lang, tag);
const linked = indexable && !!twin && tagIndexable(other(lang), twin);
const twinExists = !!twin && (await getPosts(other(lang))).some((post) => post.data.tags.includes(twin));
const intro = tagIntro[tag];
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: tr('nav.blog'), url: `/${lang}/blog/` },
  { name: `#${tag}`, url: `/${lang}/blog/tags/${tag}/` },
];
---

<Base
  lang={lang}
  title={`#${tag}`}
  description={indexable && intro ? intro : `${tr('blog.tagDesc')} #${tag}`}
  alternate={linked}
  noindex={!indexable}
  motion={false}
  altPath={twinExists && twin ? `/${other(lang)}/blog/tags/${encodeURIComponent(twin)}/` : undefined}
  crumbs={crumbs}
>
  <section class="section container">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <p class="kicker">{tr('blog.tag')}</p>
    <h1 class="section-title">#{tag}</h1>
    {intro && <p class="intro">{intro}</p>}
    <a href={`/${lang}/blog/`} class="back">{tr('blog.back')}</a>
    <ol class="notes">
      {posts.map((post, i) => (
        <li>
          <a href={postUrl(post)}>
            <b>{(i + 1).toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US').padStart(2, lang === 'fa' ? '۰' : '0')}</b>
            <span>
              <strong>{post.data.title}</strong>
              <small>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
                {' · '}
                {(minutes(post)).toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US')} {tr('blog.minutes')}
              </small>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .kicker {
    color: var(--muted);
    margin: 0;
  }
  .intro {
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin: 0.4rem 0 0.2rem;
  }
  .back {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    margin: 0.5rem 0 2rem;
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .notes a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .notes li:last-child a {
    border-bottom: 1px solid var(--border);
  }
  .notes b {
    color: var(--accent2);
    font-size: 0.8rem;
    font-weight: 700;
    padding-top: 0.2rem;
  }
  .notes strong {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--fg);
  }
  .notes small {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
