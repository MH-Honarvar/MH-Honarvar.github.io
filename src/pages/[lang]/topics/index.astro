---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { articlePublished, articleTitle, topics, topicsIndex } from '../../../content/topics';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const loose = topicsIndex.articles.filter((article) => articlePublished(lang, article.slug));
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: topicsIndex.title[lang], url: `/${lang}/topics/` },
];
---

<Base
  lang={lang}
  title={topicsIndex.title[lang]}
  description={topicsIndex.description[lang]}
  motion={false}
  crumbs={crumbs}
  extra={[{
    '@type': 'ItemList',
    itemListElement: topics.map((topic, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: topic.title[lang],
      url: new URL(`/${lang}/topics/${topic.id}/`, Astro.site).href,
    })),
  }]}
>
  <article class="section container topics" data-pagefind-body>
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <h1 class="section-title">{topicsIndex.title[lang]}</h1>
    <p class="section-lede">{topicsIndex.lede[lang]}</p>
    <ol class="hubs">
      {
        topics.map((topic, i) => (
          <li>
            <a href={`/${lang}/topics/${topic.id}/`}>
              <b>{(i + 1).toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US').padStart(2, lang === 'fa' ? '۰' : '0')}</b>
              <span>
                <strong>{topic.title[lang]}</strong>
                {topic.summary[lang]}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    {
      loose.length > 0 && (
        <p class="aside">
          {topicsIndex.aside[lang]}{' '}
          {loose.map((article) => (
            <a href={`/${lang}/blog/${article.slug}/`}>{articleTitle(lang, article)}</a>
          ))}
        </p>
      )
    }
  </article>
</Base>

<style>
  .topics { max-width: 46rem; }
  .hubs { list-style: none; padding: 0; margin: 0; }
  .hubs a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .hubs li:last-child a { border-bottom: 1px solid var(--border); }
  .hubs b { color: var(--accent2); font-size: 0.8rem; font-weight: 700; padding-top: 0.2rem; }
  .hubs strong { display: block; margin-bottom: 0.2rem; color: var(--fg); }
  .hubs span { color: var(--muted); }
  .aside { color: var(--muted); margin: 0.2rem 0 0; }
  .aside a { color: var(--accent2); text-decoration: none; }
</style>
