---
import Base from '../../../layouts/Base.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { publicCases } from '../../../content/cases';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const item = publicCases.find((c) => c.slug === 'karkia')!;
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: tr('nav.projects'), url: `/${lang}/projects/` },
  { name: item.title[lang], url: `/${lang}/projects/${item.slug}/` },
];
---

<Base lang={lang} title={item.title[lang]} description={item.description[lang]} image={`/og/${lang}/projects.png`} crumbs={crumbs}>
  <article class="section container case" data-pagefind-body>
    <a class="back" href={`/${lang}/projects/`}>{tr('nav.projects')}</a>
    <header>
      <h1>{item.title[lang]}</h1>
      <p>{item.summary[lang]}</p>
    </header>
    {
      item.sections.map((section) => (
        <section>
          <h2>{section.heading[lang]}</h2>
          <p>{section.body[lang]}</p>
        </section>
      ))
    }
    <div class="actions">
      <a class="btn primary" href={item.site}>{tr('projects.site')}</a>
    </div>
  </article>
</Base>

<style>
  .case {
    max-width: 46rem;
  }
  .back {
    color: var(--accent);
    text-decoration: none;
  }
  header {
    margin: 1.2rem 0 1.5rem;
  }
  h1 {
    margin: 0.2rem 0 0.4rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  header p,
  section p {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  h2 {
    font-size: 1.35rem;
    margin: 1.6rem 0 0.5rem;
  }
  .actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }
</style>
