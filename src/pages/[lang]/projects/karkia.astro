---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { publicCases } from '../../../content/cases';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const tr = t(lang);
const item = publicCases.find((c) => c.slug === 'karkia')!;
const pageUrl = new URL(`/${lang}/projects/${item.slug}/`, Astro.site).href;
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: tr('nav.projects'), url: `/${lang}/projects/` },
  { name: item.title[lang], url: `/${lang}/projects/${item.slug}/` },
];
---

<Base
  lang={lang}
  title={tr('meta.karkiaTitle')}
  description={tr('meta.karkiaDesc')}
  image={`/og/${lang}/case/${item.slug}.png`}
  crumbs={crumbs}
  extra={[{
    '@type': 'CreativeWork',
    name: item.title[lang],
    description: tr('meta.karkiaDesc'),
    url: pageUrl,
    author: { '@id': new URL(`/${lang}/about/`, Astro.site).href },
    inLanguage: lang === 'fa' ? 'fa-IR' : 'en-US',
  }]}
>
  <article class="section container case" data-pagefind-body>
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <header>
      <h1 class="section-title">{item.title[lang]}</h1>
      <p class="section-lede">{item.summary[lang]}</p>
      <div class="actions">
        <a class="btn primary" href={item.site}>{tr('projects.site')}</a>
      </div>
    </header>
    {
      item.sections.map((section) => (
        <section>
          <h2>{section.heading[lang]}</h2>
          <p>{section.body[lang]}</p>
        </section>
      ))
    }
  </article>
</Base>

<style>
  .case {
    max-width: 46rem;
  }
  .case .section-lede {
    margin-bottom: 0.7rem;
  }
  header {
    margin: 0.4rem 0 0.2rem;
  }
  section p {
    margin: 0 0 0.9rem;
    color: var(--muted);
  }
  h2 {
    font-size: 1.35rem;
    margin: 2.2rem 0 0.6rem;
  }
  .actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }
</style>
