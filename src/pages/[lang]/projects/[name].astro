---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { getRepos, langColor, type Repo } from '../../../lib/github';
import { SITE_REPO, studyFor, type Study } from '../../../content/studies';
import { SITE } from '../../../config';
import RepoIcon from '../../../components/RepoIcon.astro';

export async function getStaticPaths() {
  const repos = await getRepos();
  const paths = [];
  for (const lang of languages) {
    for (const repo of repos) {
      const study = studyFor(repo.name);
      if (!study || repo.private) continue;
      paths.push({ params: { lang, name: repo.name }, props: { repo, study } });
    }
  }
  if (!paths.length) {
    const repo: Repo = {
      name: SITE_REPO,
      description: null,
      html_url: `https://github.com/${SITE.githubUser}/${SITE_REPO}`,
      homepage: 'https://mh-honarvar.github.io',
      language: 'TypeScript',
      stargazers_count: 0,
      forks_count: 0,
      topics: [],
      fork: false,
      pushed_at: '',
      created_at: '',
      private: false,
    };
    const study = studyFor(repo.name);
    if (study) {
      for (const lang of languages) paths.push({ params: { lang, name: repo.name }, props: { repo, study } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { repo, study } = Astro.props as { repo: Repo; study: Study };
const tr = t(lang);
const pageUrl = new URL(`/${lang}/projects/${repo.name}/`, Astro.site).href;
const crumbs = [
  { name: tr('nav.home'), url: `/${lang}/` },
  { name: tr('nav.projects'), url: `/${lang}/projects/` },
  { name: repo.name, url: `/${lang}/projects/${repo.name}/` },
];
const linkRe = /\[([^\]]+)\]\((\/[^)\s]+)\)/g;
function parts(text: string) {
  const out: { text: string; href?: string }[] = [];
  let last = 0;
  for (const match of text.matchAll(linkRe)) {
    const index = match.index ?? 0;
    if (index > last) out.push({ text: text.slice(last, index) });
    out.push({ text: match[1], href: `/${lang}${match[2]}` });
    last = index + match[0].length;
  }
  if (last < text.length) out.push({ text: text.slice(last) });
  return out;
}
---

<Base
  lang={lang}
  title={study.title[lang]}
  description={study.description[lang]}
  image={`/og/${lang}/case/${repo.name}.png`}
  crumbs={crumbs}
  extra={[{
    '@type': 'SoftwareSourceCode',
    name: repo.name,
    description: study.description[lang],
    codeRepository: repo.html_url,
    url: pageUrl,
    ...(repo.language ? { programmingLanguage: repo.language } : {}),
    author: { '@id': new URL(`/${lang}/about/`, Astro.site).href },
    inLanguage: lang === 'fa' ? 'fa-IR' : 'en-US',
  }]}
>
  <article class="section container case" data-pagefind-body style={`--c:${langColor(repo.language)}`}>
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <header>
      <RepoIcon name={repo.name} language={repo.language} private={false} />
      <p class="repo-name" dir="ltr">{repo.name}</p>
      <h1 class="section-title">{study.title[lang]}</h1>
      <p class="section-lede">{study.lede[lang]}</p>
    </header>
    {
      study.sections.map((section) => (
        <section>
          <h2>{section.heading[lang]}</h2>
          {section.body[lang].map((paragraph) => (
            <p>
              {parts(paragraph).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
            </p>
          ))}
        </section>
      ))
    }
    <ul class="further">
      {study.further.map((link) => <li><a href={`/${lang}${link.path}`}>{link.label[lang]}</a></li>)}
    </ul>
    <div class="actions">
      <a class="btn primary" href={repo.html_url}>GitHub</a>
      {repo.homepage && <a class="btn" href={repo.homepage}>{tr('projects.site')}</a>}
    </div>
  </article>
</Base>

<style>
  .case { max-width: 46rem; }
  .case .section-lede { margin-bottom: 0.7rem; }
  header { margin: 0.4rem 0 0.2rem; }
  .repo-name { margin: 0.8rem 0 0; color: var(--accent2); font-size: 0.9rem; }
  section p { margin: 0 0 0.9rem; color: var(--muted); }
  section a { color: var(--accent2); }
  h2 { font-size: 1.35rem; margin: 2.2rem 0 0.6rem; }
  .further { margin: 1.4rem 0 1.6rem; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .further a { color: var(--accent2); }
  .actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }
</style>
