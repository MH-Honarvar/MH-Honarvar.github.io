---
interface Props {
  mode: 'hero' | 'ambient';
}
const { mode } = Astro.props;
---

<div class="scene-fallback" aria-hidden="true"></div>
<canvas id="scene" data-mode={mode} aria-hidden="true"></canvas>
<script is:inline>
  (() => {
    const canvas = document.getElementById('scene');
    if (!canvas || canvas.dataset.mode !== 'hero') return;
    const narrow = innerWidth < 860 || innerWidth / Math.max(innerHeight, 1) < 1.05;
    document.documentElement.classList.toggle('hero-stacked', narrow);
  })();
</script>

<style>
  #scene,
  .scene-fallback {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  .scene-fallback {
    z-index: -2;
    background:
      radial-gradient(60% 50% at 70% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(50% 40% at 20% 80%, color-mix(in srgb, var(--accent2) 14%, transparent), transparent 70%),
      var(--bg);
    transition: background 0.4s;
  }
  #scene {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  #scene.ready {
    opacity: 1;
  }
</style>

<script>
  const canvas = document.getElementById('scene') as HTMLCanvasElement | null;
  if (canvas && matchMedia('(prefers-reduced-motion: reduce)').matches) canvas.remove();
  else if (canvas) {
    const start = () => {
      import('../scripts/scene').then(({ initScene }) => initScene(canvas, canvas.dataset.mode as 'hero' | 'ambient'));
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 700 });
    else requestAnimationFrame(start);
  }
</script>
