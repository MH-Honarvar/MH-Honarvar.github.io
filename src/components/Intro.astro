---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
---

<div id="intro">
  <div class="mark" aria-hidden="true">
    <span class="rule"></span>
  </div>
</div>
<script is:inline>
  (() => {
    const root = document.getElementById('intro');
    if (!root) return;
    try {
      if (new URLSearchParams(location.search).get('intro') === '1') sessionStorage.removeItem('intro-seen');
    } catch { /* storage disabled */ }
    let seen = null;
    try { seen = sessionStorage.getItem('intro-seen'); } catch { /* storage disabled */ }
    if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.remove();
      return;
    }

    let leaving = false;
    let timer = 0;
    const onKey = (event) => {
      if (event.key === 'Escape') leave();
    };
    const leave = () => {
      if (leaving) return;
      leaving = true;
      clearTimeout(timer);
      removeEventListener('keydown', onKey);
      try { sessionStorage.setItem('intro-seen', '1'); } catch { /* storage disabled; still dismiss */ }
      root.classList.add('out');
      window.dispatchEvent(new Event('introout'));
      setTimeout(() => root.remove(), 700);
    };
    // The line finishes drawing at 900ms. Leave after a short rest.
    timer = setTimeout(leave, 980);
    root.addEventListener('click', leave);
    addEventListener('keydown', onKey);
  })();
</script>

<style>
  #intro {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: var(--bg);
    transform: scale(1.02);
    cursor: pointer;
  }
  .mark {
    inline-size: min(36rem, 72vw);
  }
  .rule {
    display: block;
    inline-size: 100%;
    block-size: 1px;
    background: linear-gradient(to left, var(--accent), var(--accent2));
    box-shadow: 0 0 22px color-mix(in srgb, var(--accent) 55%, transparent);
    transform: scaleX(0);
    transform-origin: right center;
    animation: intro-rule 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  :global([dir='ltr']) .rule {
    background: linear-gradient(to right, var(--accent), var(--accent2));
    transform-origin: left center;
  }
  #intro.out {
    pointer-events: none;
    animation: intro-curtain 0.62s ease forwards;
  }
  @keyframes intro-rule {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes intro-curtain {
    from {
      opacity: 1;
      transform: scale(1.02);
    }
    to {
      opacity: 0;
      transform: scale(1);
    }
  }
</style>
