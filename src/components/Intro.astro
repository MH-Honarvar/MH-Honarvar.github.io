---
import { SITE } from '../config';
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const lines = lang === 'fa' ? [SITE.name.fa, SITE.name.en] : [SITE.name.en, SITE.name.fa];
---

<div id="intro" data-lines={JSON.stringify(lines)}>
  <canvas aria-hidden="true"></canvas>
  <button type="button" class="intro-skip glass" data-intro-skip>{tr('intro.skip')}</button>
</div>
<script is:inline>
  if (new URLSearchParams(location.search).get('intro') === '1') sessionStorage.removeItem('intro-seen');
  if (sessionStorage.getItem('intro-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.getElementById('intro').remove();
  }
</script>

<style>
  #intro {
    position: fixed;
    inset: 0;
    z-index: auto;
    background: transparent;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .intro-skip {
    pointer-events: auto;
    position: fixed;
    z-index: 80;
    bottom: 1.4rem;
    inset-inline-end: 1.4rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    padding: 0.55rem 1rem;
    border-radius: 999px;
    cursor: pointer;
  }
  #intro.out {
    opacity: 0;
    pointer-events: none;
  }
  canvas {
    position: fixed;
    z-index: 0;
    display: block;
    width: 0;
    height: 0;
    pointer-events: none;
  }
</style>

<script>
  const root = document.getElementById('intro');
  if (root) {
    const lines: string[] = JSON.parse(root.dataset.lines!);
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(devicePixelRatio, 2);
    const W = innerWidth,
      H = innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
    const css = getComputedStyle(document.documentElement);
    const c1 = css.getPropertyValue('--accent').trim();
    const c2 = css.getPropertyValue('--accent2').trim();

    const family = '"Vazirmatn Variable", "Inter Variable", sans-serif';
    let frame = 0;
    let leaving = false;
    const finish = () => {
      if (leaving) return;
      leaving = true;
      cancelAnimationFrame(frame);
      sessionStorage.setItem('intro-seen', '1');
      root.classList.add('out');
      window.dispatchEvent(new Event('introout'));
      setTimeout(() => root.remove(), 320);
    };

    const heading = document.querySelector<HTMLElement>('.hero h1');
    const box = heading?.getBoundingClientRect();
    const pad = 24;
    let rx = pad;
    let ry = pad;
    let rw = Math.max(0, W - pad * 2);
    let rh = Math.max(0, H - pad * 2);
    if (box && box.width > 8 && box.height > 8) {
      const stacked = box.width > W * 0.62;
      if (stacked && box.top > pad * 3) {
        rh = Math.max(0, box.top - pad * 2);
      } else if (document.dir === 'rtl') {
        rw = Math.max(0, box.left - pad * 2);
      } else {
        rx = box.right + pad;
        rw = Math.max(0, W - pad - rx);
      }
    }
    if (rw < 140 || rh < 96) {
      finish();
    } else {
      canvas.style.left = `${rx}px`;
      canvas.style.top = `${ry}px`;
      canvas.style.width = `${rw}px`;
      canvas.style.height = `${rh}px`;
      canvas.width = rw * dpr;
      canvas.height = rh * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    const run = (o: CanvasRenderingContext2D, cols: number, rows: number) => {
      const data = o.getImageData(0, 0, cols, rows).data;
      const step = rw < 700 ? 2 : 3;
      const pts: { x: number; y: number; tx: number; ty: number; a: number; d: number }[] = [];
      for (let y = 0; y < rows; y += step)
        for (let x = 0; x < cols; x += step) {
          if (data[(y * cols + x) * 4 + 3] < 128) continue;
          pts.push({
            x: Math.random() * rw,
            y: Math.random() * rh,
            tx: ((x + 0.5) / cols) * rw,
            ty: ((y + 0.5) / rows) * rh,
            a: Math.random() > 0.5 ? 0 : 1,
            d: Math.random() * 0.1,
          });
        }

      const size = Math.max(2.2, (rw / cols) * step * 0.72);
      const start = performance.now();
      const tick = (now: number) => {
        if (leaving) return;
        const t = (now - start) / 1000;
        ctx.clearRect(0, 0, rw, rh);
        const pathA = new Path2D();
        const pathB = new Path2D();
        for (const p of pts) {
          const k = Math.min(Math.max((t - p.d) / 0.38, 0), 1);
          const e = 1 - Math.pow(1 - k, 3);
          const x = p.x + (p.tx - p.x) * e;
          const y = p.y + (p.ty - p.y) * e;
          (p.a ? pathB : pathA).rect(x, y, size, size);
        }
        ctx.fillStyle = c1;
        ctx.fill(pathA);
        ctx.fillStyle = c2;
        ctx.fill(pathB);
        if (t < 0.62) frame = requestAnimationFrame(tick);
        else finish();
      };
      frame = requestAnimationFrame(tick);
    };
    if (!leaving) {
      const cols = Math.min(180, Math.max(64, Math.round(rw / 6)));
      const rows = Math.max(36, Math.round(cols * (rh / rw)));
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      const big = Math.min(cols / 7, rows / 3.2, 28);
      o.fillStyle = '#fff';
      o.textAlign = 'center';
      o.textBaseline = 'middle';
      o.direction = document.dir === 'rtl' ? 'rtl' : 'ltr';
      const fontsReady = Promise.all(lines.map((l) => document.fonts.load(`800 40px ${family}`, l))).catch(() => {});
      Promise.race([fontsReady, new Promise((resolve) => setTimeout(resolve, 120))]).then(() => {
        if (leaving) return;
        o.font = `800 ${big}px ${family}`;
        o.fillText(lines[0], cols / 2, rows / 2 - big * 0.4);
        o.font = `600 ${big * 0.42}px ${family}`;
        o.fillText(lines[1], cols / 2, rows / 2 + big * 0.55);
        run(o, cols, rows);
      });
    }
    root.querySelector('[data-intro-skip]')?.addEventListener('click', finish);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') finish();
    });
  }
</script>
