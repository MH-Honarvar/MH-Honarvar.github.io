---
import Base from '../../layouts/Base.astro';
import { notFoundCopy } from '../../content/notfound';
import LostMeasure from './LostMeasure.astro';
import NotFoundWays from './NotFoundWays.astro';

const { fa } = notFoundCopy;
---

<Base lang="fa" title={fa.title} description={fa.description} noindex alternate={false} motion={false} altPath="/en/">
  <section class="miss" aria-labelledby="notfound-title">
    <div class="container stage">
      <div class="measure">
        <LostMeasure />
      </div>
      <div class="copy">
        <p class="eyebrow gradient-text">{fa.eyebrow}</p>
        <h1 id="notfound-title">{fa.title}</h1>
        <p class="lede">{fa.body}</p>
        <div class="ways">
          <NotFoundWays />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .miss {
    min-height: calc(100vh - 8rem);
    display: flex;
    align-items: flex-start;
    padding-block: clamp(1.75rem, 6vh, 3.5rem) clamp(2.5rem, 8vh, 4.5rem);
    position: relative;
  }

  .miss::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset-inline-end: -6%;
    top: 8%;
    width: min(34rem, 70vw);
    height: min(34rem, 70vw);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    pointer-events: none;
  }

  .stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    column-gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
  }

  /* Column 1 is inline-start: in RTL the Persian copy sits on the right. */
  .copy {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding-block-start: clamp(0.35rem, 2vh, 1.5rem);
  }

  .measure {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    min-height: clamp(16rem, 36vw, 26rem);
    align-self: stretch;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.6;
  }

  h1 {
    margin: 0.4rem 0 0.7rem;
    max-width: 16ch;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .lede {
    margin: 0;
    max-width: 42ch;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .ways {
    width: 100%;
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
  }

  @media (max-width: 799px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(1.25rem, 4vw, 2rem);
    }

    .measure {
      grid-column: 1;
      grid-row: 1;
      min-height: clamp(12rem, 52vw, 18rem);
    }

    .copy {
      grid-column: 1;
      grid-row: 2;
      padding-block-start: 0;
    }
  }
</style>
