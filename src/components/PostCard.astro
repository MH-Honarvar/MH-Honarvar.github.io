---
import { formatDate, t, type Lang } from '../i18n/ui';
import { minutes, postSlug, postUrl, type Post } from '../lib/blog';
interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const vt = `post-${postSlug(post).replace(/[^a-z0-9-]/gi, '')}`;
---

<a href={postUrl(post)} class="card glass reveal" data-tilt>
  <div class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
    <span>· {minutes(post).toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US')} {t(lang)('blog.minutes')}</span>
  </div>
  <h3 style={`view-transition-name: ${vt}`}>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="tags">{post.data.tags.map((tg) => <span class="tag">#{tg}</span>)}</div>
</a>

<style>
  .card {
    position: relative;
    display: block;
    padding: 1.6rem;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease-out, border-color 0.3s;
    transform-style: preserve-3d;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .card:hover::before {
    opacity: 1;
  }
  .meta {
    display: flex;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  h3 {
    font-size: 1.35rem;
    line-height: 1.35;
    margin: 0.5rem 0;
  }
  p {
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
