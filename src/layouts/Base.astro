---
import '../styles/global.css';
import { t, other, ui, type Lang } from '../i18n/ui';
import { SITE } from '../config';
import { getPosts, postUrl } from '../lib/blog';
import { toolbox } from '../content/about';
import { publicCases } from '../content/cases';
import { colophonPage } from '../content/colophon';
import { SITE_REPO, studyFor } from '../content/studies';
import { topics, topicsIndex } from '../content/topics';
import Cursor from '../components/Cursor.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Intro from '../components/Intro.astro';

interface Crumb {
  name: string;
  url: string;
}
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  altPath?: string;
  alternate?: boolean;
  intro?: boolean;
  motion?: boolean;
  ogType?: 'website' | 'article';
  keywords?: string[];
  articleSection?: string;
  published?: Date;
  modified?: Date;
  wordCount?: number;
  crumbs?: Crumb[];
  noindex?: boolean;
  extra?: Record<string, unknown>[];
}

const { lang, title, description, image = '/og/default.png', altPath, alternate = true, intro = false, motion = false, ogType = 'website', published, modified, keywords = [], articleSection, wordCount, crumbs, noindex = false, extra = [] } = Astro.props;
const tr = t(lang);
const name = SITE.name[lang];
const fullTitle = title ? (title.includes(name) ? title : `${title} — ${name}`) : name;
const desc = description ?? tr('hero.lede');
const path = Astro.url.pathname;
const switchHref = altPath ?? (path.startsWith(`/${lang}/`) ? path.replace(/^\/(fa|en)\//, `/${other(lang)}/`) : `/${other(lang)}/`);
const abs = (p: string) => new URL(p, Astro.site).href;
const pageUrl = abs(path);
const imageUrl = abs(image);
const locale = lang === 'fa' ? 'fa_IR' : 'en_US';
const inLanguage = lang === 'fa' ? 'fa-IR' : 'en-US';
const htmlLang = inLanguage;
const personId = abs(`/${lang}/about/`);
const person = {
  '@type': 'Person',
  name,
  url: personId,
  image: abs('/portrait.jpg'),
  knowsAbout: [
    ...toolbox.map((item) => item.name),
    lang === 'fa' ? 'رابط دوزبانه و راست‌به‌چپ' : 'Bilingual right-to-left interfaces',
    lang === 'fa' ? 'تایپوگرافی فارسی' : 'Persian typography',
  ],
  sameAs: [`https://github.com/${SITE.githubUser}`, `https://t.me/${SITE.telegram}`],
  ...(SITE.email ? { email: SITE.email } : {}),
};
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    name,
    url: abs(`/${lang}/`),
    inLanguage,
    author: { '@id': personId },
    publisher: { '@id': personId },
  },
  { ...person, '@id': personId },
];
if (ogType === 'article' && published && title) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description: desc,
    datePublished: published.toISOString(),
    ...(modified ? { dateModified: modified.toISOString() } : {}),
    image: imageUrl,
    inLanguage,
    ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    ...(articleSection ? { articleSection } : {}),
    ...(wordCount && wordCount > 0 ? { wordCount } : {}),
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    author: { '@id': personId },
  });
}
if (extra.length) graph.push(...extra);
if (crumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.url) })),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const defaultHref = lang === 'fa' ? pageUrl : abs(switchHref);
const showAlt = !noindex && alternate;
const nav = [
  { href: `/${lang}/`, label: tr('nav.home') },
  { href: `/${lang}/blog/`, label: tr('nav.blog') },
  { href: `/${lang}/projects/`, label: tr('nav.projects') },
  { href: `/${lang}/about/`, label: tr('nav.about') },
];

const index = [];
for (const l of ['fa', 'en'] as const) {
  const lt = t(l);
  index.push(
    { title: lt('nav.home'), url: `/${l}/`, kind: 'page', lang: l },
    { title: lt('nav.blog'), url: `/${l}/blog/`, kind: 'page', lang: l },
    { title: lt('nav.projects'), url: `/${l}/projects/`, kind: 'page', lang: l },
    { title: lt('nav.about'), url: `/${l}/about/`, kind: 'page', lang: l },
    { title: lt('nav.services'), url: `/${l}/services/`, kind: 'page', lang: l },
    { title: lt('nav.map'), url: `/${l}/map/`, kind: 'page', lang: l },
    { title: colophonPage.title[l], url: `/${l}/colophon/`, kind: 'page', lang: l },
    { title: topicsIndex.title[l], url: `/${l}/topics/`, kind: 'page', lang: l },
  );
  for (const topic of topics) index.push({ title: topic.title[l], url: `/${l}/topics/${topic.id}/`, kind: 'page', lang: l });
  for (const item of publicCases) index.push({ title: item.title[l], url: `/${l}/projects/${item.slug}/`, kind: 'page', lang: l });
  const siteStudy = studyFor(SITE_REPO);
  if (siteStudy) index.push({ title: siteStudy.title[l], url: `/${l}/projects/${SITE_REPO}/`, kind: 'page', lang: l });
  for (const p of await getPosts(l)) index.push({ title: p.data.title, url: postUrl(p), kind: 'post', lang: l });
}
---

<!doctype html>
<html lang={htmlLang} dir={ui[lang].dir} data-theme="neon" data-motion={motion ? 'rich' : 'plain'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#07060d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://github.com" />
    <link rel="canonical" href={pageUrl} />
    {!noindex && <link rel="alternate" hreflang={inLanguage} href={pageUrl} />}
    {showAlt && <link rel="alternate" hreflang={lang === 'fa' ? 'en-US' : 'fa-IR'} href={abs(switchHref)} />}
    {showAlt && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
    <link rel="alternate" type="application/rss+xml" title={name} href={`/${lang}/rss.xml`} />
    <meta name="author" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ? fullTitle : name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale} />
    {showAlt && <meta property="og:locale:alternate" content={lang === 'fa' ? 'en_US' : 'fa_IR'} />}
    <meta property="og:site_name" content={name} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {ogType === 'article' && keywords.filter(Boolean).map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title ? fullTitle : name} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (() => {
        const allowed = ['neon', 'cyber', 'light'];
        const t = localStorage.getItem('theme');
        if (t && allowed.includes(t)) document.documentElement.dataset.theme = t;
        const theme = document.documentElement.dataset.theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f4fb' : theme === 'cyber' ? '#030807' : '#07060d');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('no-motion');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{tr('skip')}</a>
    {intro && <Intro lang={lang} />}
    <div class="atmosphere" aria-hidden="true"></div>
    <Cursor />

    <header class="site-header">
      <div class="container bar glass">
        <a href={`/${lang}/`} class="logo" data-magnetic style="view-transition-name: site-logo">
          <span class="gradient-text">{lang === 'fa' ? 'م.ه' : 'M.H'}</span>
        </a>
        <nav class="site-nav">
          {nav.map((n) => {
            const on = n.href === path || (n.href !== `/${lang}/` && path.startsWith(n.href));
            return <a href={n.href} class:list={{ active: on }} aria-current={on ? 'page' : undefined}>{n.label}</a>;
          })}
        </nav>
        <div class="tools">
          <button class="icon" id="cmd-open" dir="ltr" aria-label={tr('cmd.hint')} title={tr('cmd.hint')}>⌘K</button>
          <button class="icon" id="theme-btn" aria-label={tr('theme')} title={tr('theme')}>◐</button>
          <a class="icon lang" href={switchHref} dir={lang === 'fa' ? 'ltr' : 'rtl'} hreflang={lang === 'fa' ? 'en-US' : 'fa-IR'}>{tr('switch')}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer container">
      <span class="glow-line" aria-hidden="true"></span>
      <div class="brand">
        <p>© {new Date().getFullYear()} {name}</p>
        <p class="built">{tr('footer.built')}</p>
      </div>
      <p class="links">
        <a href={`https://github.com/${SITE.githubUser}`} rel="me" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" /></svg>
          GitHub
        </a>
        {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        <a href={`https://t.me/${SITE.telegram}`} rel="me" aria-label="Telegram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.4c-.24 1.07-.87 1.33-1.76.83l-4.87-3.59-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.96 9.03-8.16c.39-.35-.09-.54-.61-.2L6.35 13.1l-4.8-1.5c-1.04-.33-1.06-1.04.22-1.54L20.5 2.85c.87-.32 1.63.2 1.4 1.45z" /></svg>
          Telegram
        </a>
        <a href={`/${lang}/services/`}>{tr('nav.services')}</a>
        <a href={`/${lang}/rss.xml`} aria-label="RSS">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5 17a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 10a11 11 0 0 1 11 11h-3a8 8 0 0 0-8-8v-3zm0-6a17 17 0 0 1 17 17h-3A14 14 0 0 0 3 7V4z" /></svg>
          RSS
        </a>
      </p>
      <p class="hint">{tr('cmd.hint')}</p>
    </footer>

    <button class="to-top glass" data-top type="button" aria-label={tr('blog.top')} title={tr('blog.top')}>↑</button>

    <CommandPalette lang={lang} index={index} />
  </body>
</html>

<style>
  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 70% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(50% 40% at 20% 80%, color-mix(in srgb, var(--accent2) 14%, transparent), transparent 70%),
      var(--bg);
  }
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    top: 0;
    z-index: 80;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    transform: translateY(-140%);
  }
  .skip:focus {
    transform: none;
  }
  .site-header {
    position: sticky;
    top: 0.8rem;
    z-index: 50;
    padding-top: 0.8rem;
  }
  main {
    position: relative;
    z-index: 1;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.55rem;
    padding-inline: 1.1rem 0.8rem;
    border-radius: 999px;
  }
  .logo {
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
    min-width: 0;
  }
  nav a {
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    color: var(--fg);
    background: var(--glass);
  }
  .tools {
    display: flex;
    flex-shrink: 0;
    gap: 0.35rem;
  }
  .icon {
    font: inherit;
    font-size: 0.85rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    text-decoration: none;
  }
  .icon:hover,
  .icon:focus-visible {
    border-color: var(--accent);
  }
  /* Rings stay inside the glass bar. backdrop-filter clips outline-offset. */
  .bar :focus-visible,
  .to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }
  .site-header .bar {
    transition: padding 0.35s, background 0.35s, box-shadow 0.35s, transform 0.35s;
  }
  :global(html.scrolled) .site-header .bar {
    padding-block: 0.3rem;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    box-shadow: 0 12px 40px -18px rgba(0, 0, 0, 0.5);
    transform: scale(0.98);
  }
  .site-footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3rem;
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4rem;
  }
  .glow-line {
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), var(--accent2), transparent);
    opacity: 0.7;
  }
  .glow-line::after {
    content: '';
    position: absolute;
    inset: -6px 20%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 40%, transparent), transparent);
    filter: blur(8px);
  }
  .site-footer p {
    margin: 0;
  }
  .built {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    min-width: 0;
    max-width: 100%;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--fg);
  }
  .hint {
    opacity: 0.6;
  }
  .to-top {
    position: fixed;
    bottom: 1.5rem;
    inset-inline-end: 1.5rem;
    z-index: 45;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font: inherit;
    font-size: 1.1rem;
    color: var(--fg);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
  }
  .to-top.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (max-width: 720px) {
    .to-top {
      bottom: 5rem;
    }
  }
  :global(html.no-motion) .to-top {
    transition: none;
  }
  @media (max-width: 720px) {
    /* backdrop-filter and transform on .bar would trap this fixed nav. */
    .bar {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: color-mix(in srgb, var(--bg2) 88%, transparent);
    }
    :global(html.scrolled) .site-header .bar {
      transform: none;
    }
    nav {
      position: fixed;
      bottom: 1rem;
      inset-inline: 1rem;
      justify-content: space-around;
      margin-inline: 0;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.35rem;
      z-index: 40;
    }
    nav a {
      padding-inline: 0.55rem;
    }
    .bar {
      justify-content: space-between;
      gap: 0.5rem;
      padding-inline: 0.7rem;
    }
    .tools {
      gap: 0.15rem;
    }
    .icon {
      padding: 0.3rem 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  const topBtn = document.querySelector<HTMLButtonElement>('[data-top]');
  const onScroll = () => {
    document.documentElement.classList.toggle('scrolled', scrollY > 40);
    topBtn?.classList.toggle('show', scrollY > innerHeight * 0.55);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  topBtn?.addEventListener('click', () => {
    const reduce = document.documentElement.classList.contains('no-motion') || matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) scrollTo(0, 0);
    else document.dispatchEvent(new CustomEvent('site-scroll', { detail: 'top' }));
  });
  import '../scripts/ui/motion';
  import '../scripts/ui/theme';
  import '../scripts/ui/konami';
</script>
